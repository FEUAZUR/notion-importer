{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./tests-dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "comment": "Only browser-free modules: filesystem.ts configures a zip.js worker at import time.",
  "include": [
    "tests/suite.ts",
    "src/libs/path-utils.ts",
    "src/libs/formats/notion/notion-utils.ts"
  ],
  "references": []
}
