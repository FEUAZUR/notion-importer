{
  "name": "notion-importer",
  "version": "1.1.0",
  "type": "module",
  "description": "Import Notion HTML exports into SiYuan with deterministic hierarchy, databases, media, and style preservation",
  "repository": "https://github.com/FEUAZUR/notion-importer",
  "homepage": "https://github.com/FEUAZUR/notion-importer",
  "author": "FEUAZUR",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "scripts": {
    "make-link": "node  --no-warnings ./scripts/make_dev_link.js",
    "dev": "vite build --watch",
    "build": "vite build",
    "make-install": "vite build && node --no-warnings ./scripts/make_install.js",
    "test": "tsc -p tsconfig.tests.json && node tests-dist/tests/suite.js",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.15.3",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "sass": "^1.102.0",
    "siyuan": "1.2.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "dependencies": {
    "@siyuan-community/siyuan-sdk": "^0.3.17",
    "@zip.js/zip.js": "^2.8.34"
  }
}
